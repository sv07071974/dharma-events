{
  "name": "dharma-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dharma Events - self-hosted event registration, QR check-in and attendance platform",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present --workspace-concurrency=1 run test",
    "build": "pnpm -r --if-present run build",
    "dev:web": "pnpm --filter @dharma-events/web dev",
    "dev:api": "pnpm --filter @dharma-events/api dev",
    "dev:worker": "pnpm --filter @dharma-events/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
