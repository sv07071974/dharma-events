  },
  "dependencies": {
    "@dharma-events/database": "workspace:*",
    "@dharma-events/shared": "workspace:*",
    "nodemailer": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
