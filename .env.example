NODE_ENV=development

APP_NAME=Dharma Events
PUBLIC_URL=http://localhost:8088

# Docker Compose (production) uses these to provision the postgres container.
POSTGRES_DB=dharma_events
POSTGRES_USER=dharma_events
POSTGRES_PASSWORD=change_me

# Full connection string used by the API/worker (Prisma).
DATABASE_URL=postgresql://dharma_events:change_me@postgres:5432/dharma_events

SESSION_SECRET=change_me_to_a_random_32_plus_character_value
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dharma Events

QR_TOKEN_BYTES=24

# Section 20 CC rules: optionally CC the volunteer who registered the
# attendee, and/or a shared registration-desk mailbox, on every invitation.
INVITATION_CC_VOLUNTEER=false
INVITATION_CC_REGISTRATION_MAILBOX=

EMAIL_WORKER_BATCH_SIZE=10
EMAIL_MAX_RETRIES=4

LOG_LEVEL=info

# Absolute path where scripts/backup.sh writes database/config backups.
# Defaults to ./backups (repo root) if unset - override to a path on
# persistent storage in production, e.g. /volume1/docker/dharma-events/backups
BACKUP_DIR=
